# Copy this file to .env and fill in real values. .env is gitignored; this file is the committed template.
#
#   cp .env.example .env
#
# Keys live ONLY in .env. Never in code, never in the transcript repos, never in commits.

# Anthropic — Haiku 5.5 anchor seat (and any other Claude seats)
ANTHROPIC_API_KEY=

# OpenRouter — cross-provider seats (one OpenAI + one open-weights, per convening decisions)
# Get/manage keys at https://openrouter.ai/settings/keys — set a credit limit on the key there.
OPENROUTER_API_KEY=
